NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01
SANITY_REVALIDATE_SECRET=
SANITY_API_READ_TOKEN=

# Commerce database (provisioned via `vercel integration add neon`; pulled
# automatically into .env.local by `vercel env pull`, not set by hand)
DATABASE_URL=

# Stripe (provisioned via `vercel integration add stripe`; sandbox until claimed)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Set after creating a webhook endpoint (Stripe dashboard or `stripe listen`)
# pointed at /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# PayPal (no Vercel Marketplace integration exists for this — create a sandbox
# app at developer.paypal.com and paste its Client ID/Secret here)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# https://api-m.sandbox.paypal.com for testing, https://api-m.paypal.com when live
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Shippo (no Vercel Marketplace integration exists for this — create an
# account at goshippo.com, use a test token to start). Orders are pushed here
# for the client to buy labels in Shippo's dashboard (semi-automated fulfillment).
SHIPPO_API_TOKEN=
# Shared secret for the webhook URL registered in Shippo's dashboard, e.g.
# https://<your-domain>/api/webhooks/shippo?secret=<this value> — Shippo
# doesn't sign webhook payloads, so this is the only verification we get.
SHIPPO_WEBHOOK_SECRET=

# Resend (using the existing Globalist.Pro account for now — add the key with
# `vercel env add RESEND_API_KEY development` rather than pasting it here)
RESEND_API_KEY=
RESEND_FROM_EMAIL="ELYXIER <advisor@globalist.pro>"
# Internal address that gets a copy of every new paid order
BUSINESS_NOTIFICATION_EMAIL=

# Clerk (provisioned via `vercel integration add clerk`; sandbox until claimed)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
